{
  "name": "directus-extension-audio-detection",
  "private": true,
  "description": "Directus Audio Detection Extension",
  "icon": "extension",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manya-luminate/directus-extension-audio-detection"
  },
  "license": "MIT",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "./dist/index.js",
    "source": "./src/index.ts",
    "host": "10.0.0"
  },
  "scripts": {
    "prepare": "directus-extension build",
    "build": "directus-extension build",
    "dev": "directus-extension build --watch"
  },
  "devDependencies": {
    "@directus/api": "11.1.0",
    "@directus/extensions-sdk": "10.1.4",
    "@directus/types": "10.1.1",
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3"
  }
}
